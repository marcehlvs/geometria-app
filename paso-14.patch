+// Una terna pitagórica, a veces ampliada al doble: [cateto, cateto, hipotenusa]
+const ternaAleatoria = (r) => {
+  const k = r.pick([1, 2]);
+  return r.pick(PITAGORAS.ternas).map((x) => x * k);
+};
+
+const ANIOS_TODOS = [1, 2];
